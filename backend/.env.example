# بيانات الاتصال بقاعدة البيانات MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=laser_cnc_system

# منفذ السيرفر
PORT=5000

# مفتاح تشفير JWT — غيّره لقيمة عشوائية طويلة وسرية قبل النشر
JWT_SECRET=change_this_to_a_long_random_secret_key_before_deploy
JWT_EXPIRES_IN=7d

# كود إضافة المستخدمين (مطابق للنظام الأصلي)
ADMIN_CODE=4001

# عنوان الفرونت إند المسموح له بالاتصال (CORS) — عدّله لرابط موقعك بعد النشر
CLIENT_ORIGIN=*

# الحد الأقصى لحجم الملف المرفوع بالميجابايت
MAX_FILE_SIZE_MB=100

# ====================================================================
# تخزين الملفات الدائم — Cloudflare R2 (مجاني حتى 10GB، بدون حذف تلقائي)
# اتركها فارغة أثناء التطوير المحلي (سيستخدم النظام القرص المحلي تلقائياً).
# عبّئها قبل النشر النهائي لضمان عدم فقدان الملفات على الاستضافات المجانية.
# الحصول عليها من: Cloudflare Dashboard → R2 → Manage API Tokens
# ====================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=laser-cnc-files

