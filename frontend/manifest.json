{
  "name": "نظام إدارة ماكينات الليزر",
  "short_name": "الليزر CNC",
  "description": "نظام إدارة ملفات ماكينات الليزر/CNC",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0e1a",
  "theme_color": "#0a0e1a",
  "dir": "rtl",
  "lang": "ar",
  "icons": [
    { "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "sharedFile",
          "accept": [
            ".dxf", ".svg", ".ai", ".dwg", ".pdf", ".png", ".jpg", ".jpeg", ".crv3d",
            ".zip", ".rar", ".txt", ".doc", ".docx",
            "image/*", "application/pdf", "application/octet-stream", "*/*"
          ]
        }
      ]
    }
  }
}
